# LLM provider: openrouter (default on Render), ollama, or auto
# auto = use Ollama when reachable, else OpenRouter (good for local dev + Tailscale VM)
LLM_PROVIDER=auto

# OpenRouter (required for Render; fallback when VM is offline in auto mode)
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=http://localhost:8080
OPENROUTER_APP_TITLE=BeatIt

# Secured access — comma-separated usernames, one shared password
# Example: AUTH_USERNAME=simon.brightman@gmail.com,dov@bright-man.com
AUTH_USERNAME=
AUTH_PASSWORD=
# Optional extra signing secret (defaults to AUTH_PASSWORD)
# AUTH_SECRET=

# Ollama on Tailscale VM (see docs/TAILSCALE_OLLAMA_SETUP.md)
# Tailscale IPv4 example — use your VM's address from: tailscale ip -4
OLLAMA_BASE_URL=http://100.x.x.x:11434
# Recommended for 16 GB VM: qwen2.5:7b-instruct
OLLAMA_MODEL=qwen2.5:7b-instruct
# Vision model for CT slice reads (Imaging tab). Lighter option that works without mllama:
# ollama pull moondream
OLLAMA_VISION_MODEL=moondream
# Heavier alternative if your Ollama build supports it: ollama pull llama3.2-vision:11b
# OLLAMA_VISION_MODEL=llama3.2-vision:11b
# Max seconds to wait for a generation (CPU models are slow). Default 1800 (30 min).
OLLAMA_GENERATE_TIMEOUT=1800

# App settings
DATA_DIR=./data
HOST=0.0.0.0
PORT=8080

# Set automatically on Render
# PUBLIC_URL=https://your-app.onrender.com
# RENDER_EXTERNAL_URL=https://your-app.onrender.com
