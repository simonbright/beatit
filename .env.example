# LLM provider: openrouter (default), ollama, or auto
LLM_PROVIDER=openrouter

# OpenRouter
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=google/gemini-2.0-flash-lite-001
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=http://localhost:8080
OPENROUTER_APP_TITLE=BeatIt

# Secured access — comma-separated usernames, one shared password
# Example: AUTH_USERNAME=simon.brightman@gmail.com,dov@bright-man.com
AUTH_USERNAME=
AUTH_PASSWORD=
# Optional extra signing secret (defaults to AUTH_PASSWORD)
# AUTH_SECRET=

# Ollama (optional, when remote server is ready)
OLLAMA_BASE_URL=http://your-remote-server:11434
OLLAMA_MODEL=llama3.2

# App settings
DATA_DIR=./data
HOST=0.0.0.0
PORT=8080

# Set automatically on Render
# PUBLIC_URL=https://your-app.onrender.com
# RENDER_EXTERNAL_URL=https://your-app.onrender.com
